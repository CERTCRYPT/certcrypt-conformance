{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certcrypt.com/schemas/settlement-material.schema.json",
  "title": "CERTCRYPT Settlement Material (settlement-material/1 under settlement.aggregated.xrpl/1)",
  "description": "The wire form of the settlement material of one leaf, as settlement.aggregated.xrpl/1 §9.5 fixes it. Passing this schema is necessary, not sufficient: the rules a schema cannot express are listed in `$comment` and decided by the verifier.",
  "$comment": "Not expressible here and enforced by a conformant verifier: (1) every value the rules domain publishes (chain_id, from, contract, token_contract, name, token_symbol) equals the published value; (2) the quantity is strictly positive and the totals agree (settlement.aggregated.xrpl/1 §10.1); (3) the memo equals the anchor recomputed from batch_binding_preimage (settlement.binding/1 §5); (4) every batch_manifest member repeats the anchored batch_binding_preimage, and every authorization bridge carries the same batch_binding_preimage; (5) the leaf hash, the inclusion path and leaf_index < leaf_count (settlement.binding/1 §6, §8); (6) last_irreversible_block_num >= block_num and block_timestamp is a real calendar instant (settlement.aggregated.xrpl/1 §11.3, §12); (7) coherence_material, when present, names the proof's system domain, rules domain and profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "settlement_profile_id",
    "settlement_action",
    "finality_proof",
    "batch_manifest",
    "capacity_consumption_proof",
    "submission_assignment_proof",
    "authorization_bridge_proofs"
  ],
  "properties": {
    "settlement_profile_id": {
      "const": "settlement.aggregated.xrpl/1",
      "description": "The settlement profile. Exactly this value."
    },
    "settlement_action": {
      "description": "The settlement transaction as the material declares it (settlement.aggregated.xrpl/1 §9.2).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "quantity",
        "memo",
        "contract",
        "name",
        "chain_id",
        "trx_id",
        "action_ordinal"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "description": "The account the settlement debits: xrpl_settlement_account."
        },
        "quantity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2} CERT$",
          "description": "Settled quantity, `<integer>.<2 digits> CERT` (settlement.aggregated.xrpl/1 §9.3)."
        },
        "memo": {
          "type": "string",
          "pattern": "^ccab1:[0-9a-f]{64}$",
          "description": "The batch binding memo: `ccab1:` followed by the anchor digest (settlement.binding/1 §5)."
        },
        "contract": {
          "type": "string",
          "minLength": 1,
          "description": "The MPT issuance identifier: xrpl_mpt_issuance_id."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The transaction type: xrpl_action_name (`payment`)."
        },
        "chain_id": {
          "type": "string",
          "pattern": "^[^:]+$",
          "description": "The network identity: xrpl_chain_id."
        },
        "trx_id": {
          "type": "string",
          "pattern": "^[^:]+$",
          "description": "The settlement transaction's hash."
        },
        "action_ordinal": {
          "const": "0",
          "description": "Always `0` under this profile (settlement.aggregated.xrpl/1 §8.1)."
        }
      }
    },
    "finality_proof": {
      "description": "The inclusion and irreversibility facts (settlement.aggregated.xrpl/1 §8.3, §11).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_num",
        "block_id",
        "last_irreversible_block_num",
        "last_irreversible_block_id",
        "block_timestamp"
      ],
      "properties": {
        "block_num": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "ledger_index of the validated ledger that includes the transaction."
        },
        "block_id": {
          "type": "string",
          "minLength": 1,
          "description": "ledger_hash of that ledger."
        },
        "last_irreversible_block_num": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "ledger_index of a validated ledger at or after inclusion."
        },
        "last_irreversible_block_id": {
          "type": "string",
          "minLength": 1,
          "description": "ledger_hash of that ledger."
        },
        "block_timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "description": "Close time of the inclusion ledger, RFC 3339 UTC (settlement.aggregated.xrpl/1 §12)."
        }
      }
    },
    "batch_manifest": {
      "description": "Unsigned restatement of the anchored batch description (settlement.binding/1 §6). Accepted only where every member repeats batch_binding_preimage; never a reference. Unrelated to any signed manifest of batch history.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "rules_version",
        "settlement_profile_id",
        "batch_id",
        "window_id",
        "leaf_count",
        "total_quantity",
        "settlement_root"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1,
          "description": "The system domain."
        },
        "rules_version": {
          "type": "string",
          "minLength": 1,
          "description": "The rules domain."
        },
        "settlement_profile_id": {
          "const": "settlement.aggregated.xrpl/1",
          "description": "The settlement profile. Exactly this value."
        },
        "batch_id": {
          "type": "string",
          "pattern": "^[^:]+$",
          "description": "The settlement container's batch identifier; a settlement_ref segment, so it carries no colon."
        },
        "window_id": {
          "type": "string",
          "pattern": "^[^:]+$",
          "description": "The settlement window identifier; a settlement_ref segment, so it carries no colon."
        },
        "leaf_count": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "Number of leaves in the batch tree: the tree's width (settlement.binding/1 §6)."
        },
        "total_quantity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
          "description": "Total settled quantity of the batch, canonical decimal with exactly two fractional digits."
        },
        "settlement_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Root of the batch tree (settlement.binding/1 §6)."
        }
      }
    },
    "capacity_consumption_proof": {
      "description": "The settlement-bound consumption (settlement.aggregated.xrpl/1 §10.1).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_quantity",
        "leaf_quantity",
        "token_symbol",
        "token_contract"
      ],
      "properties": {
        "total_quantity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
          "description": "The batch total: equals the settled quantity and batch_binding_preimage.total_quantity."
        },
        "leaf_quantity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
          "description": "The leaf's share: equals leaf_preimage.consumed_quantity."
        },
        "token_symbol": {
          "type": "string",
          "minLength": 1,
          "description": "xrpl_token_symbol (`CERT`)."
        },
        "token_contract": {
          "type": "string",
          "minLength": 1,
          "description": "The MPT issuance identifier: xrpl_mpt_issuance_id."
        }
      }
    },
    "submission_assignment_proof": {
      "description": "Places the leaf in the batch tree (settlement.binding/1 §6, §8).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subtree_root",
        "leaf_index",
        "leaf_preimage",
        "leaf_hash",
        "sibling_hashes"
      ],
      "properties": {
        "subtree_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The leaf's subtree_root; equals leaf_preimage.subtree_root and the proof's subtree_root."
        },
        "leaf_index": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "The leaf's position; equals leaf_preimage.leaf_index."
        },
        "leaf_preimage": {
          "description": "The leaf preimage, members in this order (settlement.binding/1 §6).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "v",
            "system_id",
            "rules_version",
            "settlement_profile_id",
            "batch_id",
            "leaf_index",
            "subtree_root",
            "cost_commitment",
            "consumed_quantity"
          ],
          "properties": {
            "v": {
              "const": "ccab1-leaf",
              "description": "Preimage discriminator."
            },
            "system_id": {
              "type": "string",
              "minLength": 1,
              "description": "The system domain."
            },
            "rules_version": {
              "type": "string",
              "minLength": 1,
              "description": "The rules domain."
            },
            "settlement_profile_id": {
              "const": "settlement.aggregated.xrpl/1",
              "description": "The settlement profile. Exactly this value."
            },
            "batch_id": {
              "type": "string",
              "pattern": "^[^:]+$",
              "description": "Batch identifier."
            },
            "leaf_index": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "description": "0-based position of the leaf in the batch tree."
            },
            "subtree_root": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Merkle root over the commitments accepted into the leaf (settlement.binding/1 §7)."
            },
            "cost_commitment": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Commitment to the leaf's cost (settlement.binding/1 §6)."
            },
            "consumed_quantity": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
              "description": "Quantity the leaf consumed."
            }
          }
        },
        "leaf_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA3-256 of 0x00 followed by the leaf preimage bytes."
        },
        "sibling_hashes": {
          "description": "Inclusion path from the leaf to settlement_root, bottom up.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "authorization_bridge_proofs": {
      "description": "One bridge per distinct Level-1 authorization in the leaf (settlement-material/1 §9). All carry the same batch_binding_preimage.",
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "Authorization-to-consumption bridge.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resolved_authorization_digest",
          "cost_commitment",
          "consumed_quantity",
          "batch_binding_preimage"
        ],
        "properties": {
          "resolved_authorization_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA3-256 of the Level-1 authorization binding's signing bytes."
          },
          "cost_commitment": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Equals leaf_preimage.cost_commitment."
          },
          "consumed_quantity": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "description": "Equals leaf_preimage.consumed_quantity."
          },
          "batch_binding_preimage": {
            "description": "The anchored batch description, members in this order (settlement.binding/1 §5).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "v",
              "system_id",
              "rules_version",
              "settlement_profile_id",
              "batch_id",
              "window_id",
              "leaf_count",
              "total_quantity",
              "settlement_root"
            ],
            "properties": {
              "v": {
                "const": "ccab1",
                "description": "Preimage discriminator."
              },
              "system_id": {
                "type": "string",
                "minLength": 1,
                "description": "The system domain."
              },
              "rules_version": {
                "type": "string",
                "minLength": 1,
                "description": "The rules domain."
              },
              "settlement_profile_id": {
                "const": "settlement.aggregated.xrpl/1",
                "description": "The settlement profile. Exactly this value."
              },
              "batch_id": {
                "type": "string",
                "pattern": "^[^:]+$",
                "description": "The settlement container's batch identifier; a settlement_ref segment, so it carries no colon."
              },
              "window_id": {
                "type": "string",
                "pattern": "^[^:]+$",
                "description": "The settlement window identifier; a settlement_ref segment, so it carries no colon."
              },
              "leaf_count": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "description": "Number of leaves in the batch tree: the tree's width (settlement.binding/1 §6)."
              },
              "total_quantity": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
                "description": "Total settled quantity of the batch, canonical decimal with exactly two fractional digits."
              },
              "settlement_root": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "Root of the batch tree (settlement.binding/1 §6)."
              }
            }
          }
        }
      }
    },
    "coherence_material": {
      "description": "Optional. When present, names the proof's system domain, rules domain and profile.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "rules_version",
        "settlement_profile_id"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1,
          "description": "The system domain."
        },
        "rules_version": {
          "type": "string",
          "minLength": 1,
          "description": "The rules domain."
        },
        "settlement_profile_id": {
          "const": "settlement.aggregated.xrpl/1",
          "description": "The settlement profile. Exactly this value."
        }
      }
    }
  }
}
