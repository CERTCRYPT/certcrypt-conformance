  "negative_cases": [
    {
      "name": "declared_cardinality as a JSON number token -> non-conformant",
      "collection_subject": {
        "commitment_scheme": "collection.merkle-sha3-256/1",
        "root": "326fce21ee9bf021ff83b83fc16aae00455c7d88b00da3345daad4f810c6544a",
        "declared_cardinality": 1,
        "leaves": [
          { "profile": "subject.binary/1", "commitment_digest_hex": "84ee4efec704171280f128479ed1bfa93f3346a91c529af84a91019444ced5aa" }
        ]
      },
      "expected_outcome": "REJECTED",
      "why": "declared_cardinality must be a string; a JSON number token violates the string-only discipline and the member-type rule"
    },
    {
      "name": "declared_cardinality with a leading zero -> non-conformant grammar",
      "collection_subject": {
        "commitment_scheme": "collection.merkle-sha3-256/1",
        "root": "326fce21ee9bf021ff83b83fc16aae00455c7d88b00da3345daad4f810c6544a",
        "declared_cardinality": "01",
        "leaves": [
          { "profile": "subject.binary/1", "commitment_digest_hex": "84ee4efec704171280f128479ed1bfa93f3346a91c529af84a91019444ced5aa" }
        ]
      },
      "expected_outcome": "REJECTED",
      "why": "declared_cardinality must be canonical unsigned base-10 with no leading zeros"
    },
    {
      "name": "declared_cardinality disagrees with the number of leaves -> non-conformant",
      "collection_subject": {
        "commitment_scheme": "collection.merkle-sha3-256/1",
        "root": "326fce21ee9bf021ff83b83fc16aae00455c7d88b00da3345daad4f810c6544a",
        "declared_cardinality": "2",
        "leaves": [
          { "profile": "subject.binary/1", "commitment_digest_hex": "84ee4efec704171280f128479ed1bfa93f3346a91c529af84a91019444ced5aa" }
        ]
      },
      "expected_outcome": "REJECTED",
      "why": "declared_cardinality (2) must equal the number of leaves (1) — the volume-fairness check (verifier-toolkit/1 §8.5.3) at the precondition boundary"
    },
    {
      "name": "unexpected fifth member -> non-conformant",
      "collection_subject": {
        "commitment_scheme": "collection.merkle-sha3-256/1",
        "root": "326fce21ee9bf021ff83b83fc16aae00455c7d88b00da3345daad4f810c6544a",
        "declared_cardinality": "1",
        "leaves": [
          { "profile": "subject.binary/1", "commitment_digest_hex": "84ee4efec704171280f128479ed1bfa93f3346a91c529af84a91019444ced5aa" }
        ],
        "extra": "x"
      },
      "expected_outcome": "REJECTED",
      "why": "exactly four members are allowed; an extra member is non-conformant"
    },
    {
      "name": "uppercase hex root under the sha3-256 scheme -> non-conformant",
      "collection_subject": {
        "commitment_scheme": "collection.merkle-sha3-256/1",
        "root": "326FCE21EE9BF021FF83B83FC16AAE00455C7D88B00DA3345DAAD4F810C6544A",
        "declared_cardinality": "1",
        "leaves": [
          { "profile": "subject.binary/1", "commitment_digest_hex": "84ee4efec704171280f128479ed1bfa93f3346a91c529af84a91019444ced5aa" }
        ]
      },
      "expected_outcome": "REJECTED",
      "why": "under collection.merkle-sha3-256/1 the root must be 64 lowercase hex characters"
    },
    {
      "name": "leaf commitment_digest_hex not 64 lowercase hex -> non-conformant",
      "collection_subject": {
        "commitment_scheme": "collection.merkle-sha3-256/1",
        "root": "326fce21ee9bf021ff83b83fc16aae00455c7d88b00da3345daad4f810c6544a",
        "declared_cardinality": "1",
        "leaves": [
          { "profile": "subject.binary/1", "commitment_digest_hex": "deadbeef" }
        ]
      },
      "expected_outcome": "REJECTED",
      "why": "each leaf commitment_digest_hex must be 64 lowercase hex characters"
    }
  ],
  "must_hold": [
    "canonical_bytes(subject) == UTF-8 bytes of RFC 8785 JCS of the collection subject JSON value",
    "the object contains exactly the four members of subject.collection/1 and no others",
    "subject_local_digest_hex == SHA3-256(canonical_bytes)",
    "commitment_digest_hex == SHA3-256(ASCII(nonce_hex) || ASCII(subject_local_digest_hex)) (CCCP/1)",
    "declared_cardinality is a canonical unsigned base-10 string equal to the leaf count; a number token, leading zero, or disagreement is non-conformant (the profile does not apply)",
    "an object that violates the precondition has no canonical_bytes and MUST fail closed"
  ]
}
